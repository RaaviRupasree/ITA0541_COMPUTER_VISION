import cv2
# Open input video file
cap = cv2.VideoCapture(r"C:/Users/rupas/Videos/Captures/WATCH.mp4")
# Check whether video opened successfully
if not cap.isOpened():
    print("Error: Cannot open video")
else:
    frames = []
    # Read all frames from video
    while True:
        ret, frame = cap.read()
        if not ret:
            break
        # Resize frame
        frame = cv2.resize(frame, (500, 400))
        # Store frames
        frames.append(frame)
    # Release input video
    cap.release()
    # Get frame size
    height, width = frames[0].shape[:2]
    # Set FPS
    fps = 20
    # Create VideoWriter object
    fourcc = cv2.VideoWriter_fourcc(*'XVID')
    out = cv2.VideoWriter(
        "reverse_video.avi",
        fourcc,
        fps,
        (width, height)
    )
    # Write frames in reverse order
    for frame in reversed(frames):
        out.write(frame)
    # Release output video
    out.release()
    print("Reverse video created successfully")
    # Play reversed video
    cap2 = cv2.VideoCapture("reverse_video.avi")
    while True:
        ret, frame = cap2.read()
        if not ret:
            break
        cv2.imshow("Reversed Video", frame)
        # Press q to exit
        if cv2.waitKey(25) & 0xFF == ord('q'):
            break
    # Release and close windows
    cap2.release()
    cv2.destroyAllWindows()
