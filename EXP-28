import cv2

# Load vehicle cascade classifier
car_cascade = cv2.CascadeClassifier(
    "C:/Users/rupas/Downloads/cars.xml"
)

# Check whether cascade file loaded
if car_cascade.empty():
    print("Error: cars.xml file not loaded")
else:

    # Open video file
    cap = cv2.VideoCapture("C:/Users/rupas/Videos/Captures/TRAFFIC_VIDEO.mp4")
    # Check video
    if not cap.isOpened():
        print("Error: Cannot open video")

    else:
        while True:

            # Read frame
            ret, frame = cap.read()

            if not ret:
                break

            # Resize frame
            frame = cv2.resize(frame, (700, 500))

            # Convert frame into grayscale
            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            # Detect vehicles
            cars = car_cascade.detectMultiScale(
                gray,
                scaleFactor=1.1,
                minNeighbors=2
            )

            # Draw rectangles
            for (x, y, w, h) in cars:

                cv2.rectangle(
                    frame,
                    (x, y),
                    (x + w, y + h),
                    (0, 255, 0),
                    2
                )

                cv2.putText(
                    frame,
                    "Vehicle",
                    (x, y - 10),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,
                    (0, 255, 0),
                    2
                )

            # Display output
            cv2.imshow("Vehicle Detection", frame)

            # Exit when q is pressed
            if cv2.waitKey(25) & 0xFF == ord('q'):
                break

        # Release video
        cap.release()

        # Close windows
        cv2.destroyAllWindows()
